FROM debian:trixie-slim

RUN set -e; \
    apt-get -q update; \
    DEBIAN_FRONTEND='noninteractive' apt-get -qq -o 'Dpkg::Options::=--force-confnew' --no-install-recommends install ca-certificates curl openssl python3 fdisk; \
    mkdir /tmp/motioneye; \
    curl -sSfL 'https://codeload.github.com/${source}/tar.gz/${commit}' | tar -xz -C /tmp/motioneye --strip-components=1; \
    printf '%s\n' '[global]' 'break-system-packages=true' 'no-cache-dir=true' 'root-user-action=ignore' > /etc/pip.conf; \
    curl -sSfO 'https://bootstrap.pypa.io/get-pip.py'; \
    python3 get-pip.py; \
    python3 -m pip install -U /tmp/motioneye; \
    motioneye_init --skip-systemd --skip-apt-update; \
    DEBIAN_FRONTEND='noninteractive' apt-get -qq -o 'Dpkg::Options::=--force-confnew' --no-install-recommends install vsftpd openssh-server samba cifs-utils; \
    curl -sSfL -o /tmp/mailpit.tar.gz 'https://github.com/axllent/mailpit/releases/download/v1.33.0/mailpit-linux-arm64.tar.gz'; \
    echo '1d27c819e1a5dd2761ed9fd07022443e35a47793b2e92de5b49cf3656a649ef9  /tmp/mailpit.tar.gz' | sha256sum -c -; \
    tar -xzf /tmp/mailpit.tar.gz -C /usr/local/bin mailpit; \
    mkdir /etc/preview; \
    openssl req -x509 -newkey rsa:2048 -nodes -days 3650 -subj '/CN=localhost' -addext 'subjectAltName=DNS:localhost,IP:127.0.0.1' -keyout /etc/preview/key.pem -out /etc/preview/cert.pem; \
    python3 -m pip uninstall -y pip; \
    apt-get clean; \
    rm -r /var/lib/apt/lists /var/cache/apt /tmp/motioneye /tmp/mailpit.tar.gz get-pip.py

COPY preview /usr/local/lib/preview

RUN set -e; \
    useradd --home-dir /srv/uploads --shell /bin/sh preview; \
    echo 'preview:password' | chpasswd; \
    mkdir -p /srv/uploads/ftp /srv/uploads/sftp /srv/uploads/smb; \
    chown preview /srv/uploads/ftp /srv/uploads/sftp /srv/uploads/smb; \
    cp /usr/local/lib/preview/vsftpd.conf /etc/vsftpd.conf; \
    cp /usr/local/lib/preview/sshd.conf /etc/ssh/sshd_config.d/preview.conf; \
    cp /usr/local/lib/preview/smb.conf /etc/samba/smb.conf; \
    printf 'password\npassword\n' | smbpasswd -a -s preview; \
    python3 /usr/local/lib/preview/seed.py; \
    python3 /usr/local/lib/preview/media.py

%{ if s3 ~}
RUN set -e; \
    curl -sSfL -o /tmp/rustfs.zip 'https://github.com/rustfs/rustfs/releases/download/1.0.4/rustfs-linux-aarch64-musl-v1.0.4.zip'; \
    echo '81414fd0e41969f4f5c2e0555951cee76d3f224c112c269c80f52b31276f187a  /tmp/rustfs.zip' | sha256sum -c -; \
    python3 -c 'import zipfile; zipfile.ZipFile("/tmp/rustfs.zip").extract("rustfs", "/usr/local/bin")'; \
    chmod 755 /usr/local/bin/rustfs; \
    rm /tmp/rustfs.zip; \
    mkdir -p /srv/s3 /etc/preview/rustfs; \
    cp /etc/preview/cert.pem /etc/preview/rustfs/rustfs_cert.pem; \
    cp /etc/preview/key.pem /etc/preview/rustfs/rustfs_key.pem; \
    python3 /usr/local/lib/preview/s3bucket.py

%{ endif ~}
EXPOSE 8765 8025 8030 9000

ENTRYPOINT ["sh", "/usr/local/lib/preview/entrypoint.sh"]
