{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteOwnBuckets",
      "Effect": "Allow",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::vivarium-*",
        "arn:aws:s3:::vivarium-*/*"
      ]
    },
    {
      "Sid": "WriteOwnFunctionsAndImages",
      "Effect": "Allow",
      "Action": "lambda:*",
      "Resource": [
        "arn:aws:lambda:*:${account_id}:function:vivarium-*",
        "arn:aws:lambda:*:${account_id}:microvm-image:vivarium-*",
        "arn:aws:lambda:*:${account_id}:web-function/vivarium-*",
        "arn:aws:lambda:*:${account_id}:web-function/vivarium-*/*"
      ]
    },
    {
      "Sid": "WriteThroughCloudControl",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:UpdateResource",
        "cloudformation:DeleteResource",
        "cloudformation:CancelResourceRequest"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CreateOwnMicrovmImages",
      "Effect": "Allow",
      "Action": ["lambda:CreateMicrovmImage", "lambda:TagResource"],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Project": "vivarium"
        }
      }
    },
    {
      "Sid": "PassLambdaNetworkConnectors",
      "Effect": "Allow",
      "Action": "lambda:PassNetworkConnector",
      "Resource": "*"
    },
    {
      "Sid": "WriteNetworkConnectors",
      "Effect": "Allow",
      "Action": "lambda:*NetworkConnector*",
      "Resource": "arn:aws:lambda:*:${account_id}:network-connector:*"
    },
    {
      "Sid": "CreateOwnNetworks",
      "Effect": "Allow",
      "Action": ["ec2:CreateVpc", "ec2:CreateSubnet", "ec2:CreateSecurityGroup"],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Project": "vivarium"
        }
      }
    },
    {
      "Sid": "AddOwnNetworksToTheirVpc",
      "Effect": "Allow",
      "Action": ["ec2:CreateSubnet", "ec2:CreateSecurityGroup"],
      "Resource": "arn:aws:ec2:*:${account_id}:vpc/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Project": "vivarium"
        }
      }
    },
    {
      "Sid": "TagOwnNetworksAtCreation",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "ec2:CreateAction": ["CreateVpc", "CreateSubnet", "CreateSecurityGroup"]
        }
      }
    },
    {
      "Sid": "ManageOwnNetworks",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateTags",
        "ec2:DeleteTags",
        "ec2:DeleteVpc",
        "ec2:DeleteSubnet",
        "ec2:DeleteSecurityGroup",
        "ec2:ModifyVpcAttribute",
        "ec2:ModifySubnetAttribute",
        "ec2:RevokeSecurityGroupEgress",
        "ec2:RevokeSecurityGroupIngress"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Project": "vivarium"
        }
      }
    },
    {
      "Sid": "WriteOwnLogGroups",
      "Effect": "Allow",
      "Action": "logs:*",
      "Resource": [
        "arn:aws:logs:*:${account_id}:log-group:/vivarium/*",
        "arn:aws:logs:*:${account_id}:log-group:/vivarium/*:*"
      ]
    },
    {
      "Sid": "CreateWorkloadRolesInsideTheBoundary",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:PutRolePermissionsBoundary",
        "iam:PutRolePolicy",
        "iam:AttachRolePolicy"
      ],
      "Resource": "arn:aws:iam::${account_id}:role/vivarium-*",
      "Condition": {
        "StringEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::${account_id}:policy/vivarium-workload-boundary"
        }
      }
    },
    {
      "Sid": "ManageWorkloadRoles",
      "Effect": "Allow",
      "Action": [
        "iam:DeleteRole",
        "iam:UpdateRole",
        "iam:UpdateAssumeRolePolicy",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:DeleteRolePolicy",
        "iam:DetachRolePolicy"
      ],
      "Resource": "arn:aws:iam::${account_id}:role/vivarium-*"
    },
    {
      "Sid": "PassWorkloadRolesToLambda",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::${account_id}:role/vivarium-*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": [
            "lambda.amazonaws.com",
            "network-connectors.lambda.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "CreatePreviewEdge",
      "Effect": "Allow",
      "Action": [
        "cloudfront:CreateDistribution",
        "cloudfront:CreateOriginAccessControl",
        "cloudfront:CreateCachePolicy"
      ],
      "Resource": "*"
    },
    {
      "Sid": "TagOwnDistributionsAtCreation",
      "Effect": "Allow",
      "Action": "cloudfront:TagResource",
      "Resource": "arn:aws:cloudfront::${account_id}:distribution/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Project": "vivarium"
        }
      }
    },
    {
      "Sid": "ManageOwnDistributions",
      "Effect": "Allow",
      "Action": [
        "cloudfront:UpdateDistribution",
        "cloudfront:DeleteDistribution",
        "cloudfront:TagResource",
        "cloudfront:UntagResource"
      ],
      "Resource": "arn:aws:cloudfront::${account_id}:distribution/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Project": "vivarium"
        }
      }
    },
    {
      "Sid": "CreateOwnCloudFrontFunctions",
      "Effect": "Allow",
      "Action": "cloudfront:CreateFunction",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Project": "vivarium"
        }
      }
    },
    {
      "Sid": "ManageOwnCloudFrontFunctions",
      "Effect": "Allow",
      "Action": [
        "cloudfront:UpdateFunction",
        "cloudfront:PublishFunction",
        "cloudfront:DeleteFunction",
        "cloudfront:TagResource",
        "cloudfront:UntagResource"
      ],
      "Resource": "arn:aws:cloudfront::${account_id}:function/vivarium-*"
    },
    {
      "Sid": "ManagePreviewEdgePolicies",
      "Effect": "Allow",
      "Action": [
        "cloudfront:UpdateOriginAccessControl",
        "cloudfront:DeleteOriginAccessControl",
        "cloudfront:UpdateCachePolicy",
        "cloudfront:DeleteCachePolicy"
      ],
      "Resource": [
        "arn:aws:cloudfront::${account_id}:origin-access-control/*",
        "arn:aws:cloudfront::${account_id}:cache-policy/*"
      ]
    },
    {
      "Sid": "RequestOwnCertificates",
      "Effect": "Allow",
      "Action": ["acm:RequestCertificate", "acm:AddTagsToCertificate"],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Project": "vivarium"
        }
      }
    },
    {
      "Sid": "ManageOwnCertificates",
      "Effect": "Allow",
      "Action": [
        "acm:DeleteCertificate",
        "acm:UpdateCertificateOptions",
        "acm:AddTagsToCertificate",
        "acm:RemoveTagsFromCertificate"
      ],
      "Resource": "arn:aws:acm:us-east-1:${account_id}:certificate/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Project": "vivarium"
        }
      }
    },
    {
      "Sid": "WritePreviewDomainRecords",
      "Effect": "Allow",
      "Action": "route53:ChangeResourceRecordSets",
      "Resource": "arn:aws:route53:::hostedzone/*",
      "Condition": {
        "ForAllValues:StringLike": {
          "route53:ChangeResourceRecordSetsNormalizedRecordNames": [
            "*.${preview_domain}"
          ]
        }
      }
    },
    {
      "Sid": "KeepTheBoundary",
      "Effect": "Deny",
      "Action": "iam:DeleteRolePermissionsBoundary",
      "Resource": "arn:aws:iam::${account_id}:role/vivarium-*"
    }
  ]
}
