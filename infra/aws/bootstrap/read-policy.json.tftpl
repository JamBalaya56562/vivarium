{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadOwnBucketSettings",
      "Effect": "Allow",
      "Action": ["s3:Get*", "s3:List*"],
      "Resource": "arn:aws:s3:::vivarium-*"
    },
    {
      "Sid": "ReadPreviewArtifacts",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:GetObjectTagging", "s3:GetObjectVersion"],
      "Resource": "arn:aws:s3:::vivarium-preview-artifacts-${account_id}/previews/*"
    },
    {
      "Sid": "ReadOwnFunctionsAndImages",
      "Effect": "Allow",
      "Action": ["lambda:Get*", "lambda:List*"],
      "Resource": [
        "arn:aws:lambda:*:${account_id}:function:vivarium-*",
        "arn:aws:lambda:*:${account_id}:microvm-image:vivarium-*",
        "arn:aws:lambda:*:${account_id}:web-function/vivarium-*",
        "arn:aws:lambda:*:${account_id}:web-function/vivarium-*/*"
      ]
    },
    {
      "Sid": "ListingIsNotResourceScoped",
      "Effect": "Allow",
      "Action": [
        "lambda:ListFunctions",
        "lambda:ListMicrovmImages",
        "lambda:ListMicrovms",
        "lambda:ListWebFunctions",
        "lambda:GetWebAccountSettings",
        "lambda:GetNetworkConnector*",
        "lambda:ListNetworkConnector*",
        "ec2:Describe*",
        "logs:DescribeLogGroups"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadOwnLogGroups",
      "Effect": "Allow",
      "Action": ["logs:Describe*", "logs:ListTags*", "logs:GetDataProtectionPolicy"],
      "Resource": [
        "arn:aws:logs:*:${account_id}:log-group:/vivarium/*",
        "arn:aws:logs:*:${account_id}:log-group:/vivarium/*:*"
      ]
    },
    {
      "Sid": "ReadThroughCloudControl",
      "Effect": "Allow",
      "Action": [
        "cloudformation:GetResource",
        "cloudformation:ListResources",
        "cloudformation:GetResourceRequestStatus"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadPreviewEdge",
      "Effect": "Allow",
      "Action": [
        "cloudfront:Get*",
        "cloudfront:List*",
        "cloudfront:DescribeFunction",
        "acm:DescribeCertificate",
        "acm:GetCertificate",
        "acm:ListCertificates",
        "acm:ListTagsForCertificate",
        "route53:GetChange",
        "route53:GetDNSSEC",
        "route53:GetHostedZone",
        "route53:ListHostedZones",
        "route53:ListHostedZonesByName",
        "route53:ListResourceRecordSets",
        "route53:ListTagsForResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadIdentities",
      "Effect": "Allow",
      "Action": ["iam:Get*", "iam:List*"],
      "Resource": "*"
    }
  ]
}
